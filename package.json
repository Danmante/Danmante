{
  "name": "danmante",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "next dev",
    "api": "tsx server.ts",
    "build": "next build",
    "build:pages": "NEXT_PUBLIC_BASE_PATH=/Danmante NEXT_PUBLIC_SITE_URL=https://danmante.github.io/Danmante npm run build",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@danmante/jurisdiction": "workspace:*",
    "@danmante/security": "workspace:*",
    "@fastify/cors": "^9.0.0",
    "@fastify/helmet": "^11.1.0",
    "@fastify/rate-limit": "^9.1.0",
    "fastify": "^4.28.0",
    "next": "14.2.35",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "20.14.12",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "eslint": "8.57.0",
    "eslint-config-next": "14.2.15",
    "tsx": "^4.23.15",
    "typescript": "5.5.4",
    "vitest": "2.1.8"
  }
}
